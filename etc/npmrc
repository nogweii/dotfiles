# Move the cache location to a sub-subdirectory of ~
prefix=~/.local/node
cache=~/.local/cache/npm

editor="nvim"

# Various defaults specified so I stop repeating myself every time I run npm init
init-author-name="nogweii"
init-author-email="code@nogweii.net"
init-author-url="https://nogweii.net"
init-license="MPL-2.0"
init-version="0.1.0"

# A little nicer commit message for npm version
message="Bump version to v%s"

# Better looking tree drawing
unicode=true

@nogweii:registry=https://code.nogweii.net/api/v4/packages/npm/
https://code.nogweii.net/api/v4/packages/npm/:_authToken=$GITLAB_API_PRIVATE_TOKEN
